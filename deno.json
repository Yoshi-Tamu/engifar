{
  "imports": {
    "@std/http/file-server": "jsr:@std/http@^1.1.3/file-server",
    "pg": "npm:pg@^8.16.3",
    "@types/pg": "npm:@types/pg@^8.15.5"
  },
  "tasks": {
    "dev": "deno run --watch=server.js,src/,public/ --allow-net --allow-read=public --allow-env=DATABASE_URL,DB_POOL_SIZE,PGUSER,PGDATABASE,PGPORT,PGHOST,PGPASSWORD,PGBINARY,PGOPTIONS,PGSSLMODE,PGSSLNEGOTIATION,PGCLIENT_ENCODING,PGREPLICATION,PGAPPNAME,PGCONNECT_TIMEOUT,PGPASSFILE,USER,USERNAME,NODE_PG_FORCE_NATIVE server.js",
    "start": "deno run --allow-net --allow-read=public --allow-env=DATABASE_URL,DB_POOL_SIZE,PGUSER,PGDATABASE,PGPORT,PGHOST,PGPASSWORD,PGBINARY,PGOPTIONS,PGSSLMODE,PGSSLNEGOTIATION,PGCLIENT_ENCODING,PGREPLICATION,PGAPPNAME,PGCONNECT_TIMEOUT,PGPASSFILE,USER,USERNAME,NODE_PG_FORCE_NATIVE server.js",
    "check": "deno check server.js scripts/migrate.ts src/ tests/",
    "test": "deno test --allow-read=migrations tests/",
    "db:migrate": "deno run --allow-net --allow-read=migrations --allow-env=DATABASE_URL,DB_POOL_SIZE,PGUSER,PGDATABASE,PGPORT,PGHOST,PGPASSWORD,PGBINARY,PGOPTIONS,PGSSLMODE,PGSSLNEGOTIATION,PGCLIENT_ENCODING,PGREPLICATION,PGAPPNAME,PGCONNECT_TIMEOUT,PGPASSFILE,USER,USERNAME,NODE_PG_FORCE_NATIVE scripts/migrate.ts",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint"
  },
  "compilerOptions": {
    "strict": true,
    "types": ["npm:@types/pg"]
  },
  "fmt": {
    "include": ["deno.json", "server.js", "src/", "scripts/", "tests/"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  }
}
